{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (UCRT64 via MSYS bash)",
      "type": "shell",
      "command": "C:/msys64/usr/bin/bash.exe",
      "args": [
        "-lc",
        "export PATH=/ucrt64/bin:$PATH; cd /c/CToolkitV1 && g++ -g test.cpp zeta_mpc.cpp -o test.exe -I/ucrt64/include -L/ucrt64/lib -lmpc -lmpfr -lgmp"
      ],
      "options": {
        "cwd": "C:/CToolkitV1"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "type": "cppbuild",
      "label": "C/C++: g++.exe build *active* file",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",

        // 👇 this is the key change
        "${file}",                        // active file instead of hard-coded plot_energy.cpp
        "C:/CToolkitV1/zeta_mpc.cpp",     // always link against zeta_mpc

        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe",

        "-IC:/msys64/ucrt64/include",
        "-LC:/msys64/ucrt64/lib",
        "-lmpc",
        "-lmpfr",
        "-lgmp",
        "-lgmpxx",
        "-lflint",
      ],
      "options": {
        "cwd": "C:/msys64/ucrt64/bin"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Task generated by Debugger (build active file + zeta_mpc)."
    }
  ]
}
